@model UsuarioModel

@{
    ViewData["Title"] = "Criar Conta - LuckFin";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        * {
            box-sizing: border-box;
        }

        body, html {
            height: 100%;
            width: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            background-color: #030914;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .bg-full-screen {
            background-image: linear-gradient(to right, #030914 38%, rgba(3, 9, 20, 0) 58%), url('/Imagem/Login.png');
            background-size: contain;
            background-position: right center;
            background-repeat: no-repeat;
            height: 100vh;
            width: 100vw;
            display: flex;
            align-items: center;
            justify-content: flex-start;
            padding-left: 6vw;
            background-color: #030914;
        }

        /* Card do Formulário Flutuante */
        .login-card {
            background-color: #ffffff;
            border-radius: 24px;
            padding: 2.2rem 2rem;
            width: 100%;
            max-width: 430px;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.5);
            z-index: 10;
        }

        .brand-logo {
            color: #10b981;
            font-weight: 700;
            font-size: 1.75rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .btn-success-custom {
            background-color: #10b981;
            border-color: #10b981;
            color: white;
            font-weight: 600;
            padding: 0.7rem;
            border-radius: 12px;
            transition: all 0.2s;
        }

            .btn-success-custom:hover {
                background-color: #059669;
                border-color: #059669;
                color: white;
            }

        .form-control-custom {
            border-radius: 0 10px 10px 0;
            padding: 0.6rem 0.85rem;
            border: 1px solid #e2e8f0;
        }

            .form-control-custom:focus {
                border-color: #10b981;
                box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
            }

        .input-group-text-custom {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-right: none;
            border-radius: 10px 0 0 10px;
            color: #94a3b8;
        }

        /* Botão do Olho */
        .btn-olho-custom {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-left: none;
            border-radius: 0 10px 10px 0 !important;
            color: #94a3b8;
            padding: 0 0.9rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            transition: color 0.2s ease;
        }

            .btn-olho-custom:hover,
            .btn-olho-custom.ativo {
                color: #10b981;
            }

        /* Remove a linha divisória do lado direito do input de senha */
        .form-control-senha {
            border-radius: 0 !important;
            border: 1px solid #e2e8f0;
            border-left: none !important;
            border-right: none !important;
            padding: 0.65rem 0.5rem;
        }

            .form-control-senha:focus {
                border-color: #10b981;
                box-shadow: none !important;
            }

        /* Remove a linha divisória do lado esquerdo do botão do olho */
        .btn-olho-custom {
            background-color: #ffffff;
            border: 1px solid #e2e8f0;
            border-left: none !important;
            border-radius: 0 10px 10px 0 !important;
            color: #94a3b8;
            padding: 0 0.9rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            margin-left: 0 !important; /* Evita que o Bootstrap sobreponha a borda */
            transition: color 0.2s ease;
        }
    </style>
</head>
<body>

    <div class="bg-full-screen">
        <div class="login-card">
        
            <div class="brand-logo mb-2">
                <i class="bi bi-bar-chart-line-fill"></i> LuckFin
            </div>

            <h3 class="fw-bold text-dark mb-1">Crie sua conta</h3>
            <p class="text-muted small mb-3">Comece a gerenciar suas movimentações hoje mesmo.</p>

            <form asp-controller="Login" asp-action="Cadastrar" method="post">
            
                <div class="mb-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">Nome Completo</label>
                    <div class="input-group">
                        <span class="input-group-text input-group-text-custom">
                            <i class="bi bi-person"></i>
                        </span>
                        <input type="text" name="Nome" class="form-control form-control-custom" placeholder="Seu nome" required />
                    </div>
                </div>

                <div class="mb-2">
                    <label class="form-label small fw-semibold text-secondary mb-1">E-mail</label>
                    <div class="input-group">
                        <span class="input-group-text input-group-text-custom">
                            <i class="bi bi-envelope"></i>
                        </span>
                        <input type="email" name="Email" class="form-control form-control-custom" placeholder="seu@email.com" required />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Senha</label>
                    <div class="input-group input-group-senha">
                        <span class="input-group-text input-group-text-custom">
                            <i class="bi bi-lock"></i>
                        </span>
                        <input type="password" name="Senha" id="inputSenha" class="form-control form-control-senha" placeholder="••••••••" required />
                        <button type="button" id="btnOlho" class="btn-olho-custom" title="Mostrar ou ocultar senha">
                            <i class="bi bi-eye-slash fs-5 icone-olho-animado" id="iconeOlho"></i>
                        </button>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-secondary mb-1">Confirmar Senha</label>
                    <div class="input-group">
                        <span class="input-group-text input-group-text-custom">
                            <i class="bi bi-shield-lock"></i>
                        </span>
                        <input id="inputConfirmarSenha" type="password" name="ConfirmarSenha" class="form-control form-control-senha" placeholder="••••••••" required />
                            <button type="button" id="btnOlhoConfirmar" class="btn-olho-custom" title="Mostrar ou ocultar senha">
                            <i class="bi bi-eye-slash fs-5 icone-olho-animado" id="iconeOlhoConfirmar"></i>
                        </button>
                    </div>
                </div>

                <button type="submit" class="btn btn-success-custom w-100 mb-3">Cadastrar</button>

                <div class="text-center small text-secondary">
                    Já possui uma conta? <a asp-controller="Login" asp-action="Index" class="fw-bold text-decoration-none" style="color: #10b981;">Fazer Login</a>
                </div>

            </form>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        function ativarOlhoDinamico(idInput, idBotao, idIcone) {
            const input = document.getElementById(idInput);
            const botao = document.getElementById(idBotao);
            const icone = document.getElementById(idIcone);

            if (!input || !botao || !icone) return;

            botao.addEventListener('click', function() {
                const vaiMostrar = input.type === 'password';

                icone.classList.add('animando');

                setTimeout(() => {
                    input.type = vaiMostrar ? 'text' : 'password';

                    if (vaiMostrar) {
                        icone.classList.replace('bi-eye-slash', 'bi-eye');
                        botao.classList.add('ativo');
                    } else {
                        icone.classList.replace('bi-eye', 'bi-eye-slash');
                        botao.classList.remove('ativo');
                    }

                    icone.classList.remove('animando');
                }, 120);
            });
        }

        // Ativa o 1º campo (Senha)
        ativarOlhoDinamico('inputSenha', 'btnOlho', 'iconeOlho');

        // Ativa o 2º campo (Confirmar Senha)
        ativarOlhoDinamico('inputConfirmarSenha', 'btnOlhoConfirmar', 'iconeOlhoConfirmar');
    </script>

</body>
</html>