@model IEnumerable<SistemaGastosWeb.Models.MovimentacoesModel>

@{
    ViewData["Title"] = "Movimentações";
    
    // Cálculos dinâmicos para os cards de resumo
    var totalEntradas = Model?.Where(m => m.Tipo == "Ganho").Sum(m => m.Valor) ?? 0m;
    var totalSaidas = Model?.Where(m => m.Tipo == "Gasto").Sum(m => m.Valor) ?? 0m;
    var saldoPeriodo = totalEntradas - totalSaidas;
}

<div class="container-fluid p-0">
    <!-- Cabeçalho -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Movimentações</h2>
            <p class="text-muted small m-0">Acompanhe as entradas e saídas de caixa num só lugar</p>
        </div>
        <div>
            <a asp-controller="Movimentacoes" asp-action="Criar" asp-route-tipo="Ganho" class="btn btn-primary-custom me-2">
                <i class="bi bi-plus-lg me-1"></i> Novo Ganho
            </a>
    
            <a asp-controller="Movimentacoes" asp-action="Criar" asp-route-tipo="Gasto" class="btn btn-outline-danger" style="border-radius: 8px;">
                <i class="bi bi-dash-lg me-1"></i> Novo Gasto
            </a>
        </div>
    </div>

    <!-- Resumo do Caixa -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="custom-card mb-0">
                <div class="text-muted small fw-semibold mb-1">Total Entradas</div>
                <div class="fs-3 fw-bold text-success">R$ @totalEntradas.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="custom-card mb-0">
                <div class="text-muted small fw-semibold mb-1">Total Saídas</div>
                <div class="fs-3 fw-bold text-danger">R$ @totalSaidas.ToString("N2")</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="custom-card mb-0">
                <div class="text-muted small fw-semibold mb-1">Saldo do Período</div>
                <div class="fs-3 fw-bold @(saldoPeriodo >= 0 ? "text-dark" : "text-danger")">
                    R$ @saldoPeriodo.ToString("N2")
                </div>
            </div>
        </div>
    </div>

    <!-- Tabela Unificada de Entradas e Saídas -->
    <div class="custom-card">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold text-dark m-0">Histórico do Caixa</h5>
            <span class="badge bg-light text-secondary">@(Model?.Count() ?? 0) registo(s)</span>
        </div>

        <div class="table-responsive">
            <table class="table custom-table align-middle">
                <thead>
                    <tr>
                        <th>Data</th>
                        <th>Descrição</th>
                        <th>Tipo</th>
                        <th>Valor</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Data.ToString("dd/MM/yyyy")</td>
                                <td>@item.Descricao</td>
                                <td>
                                    <span class="badge @(item.Tipo == "Ganho" ? "bg-success" : "bg-danger")">
                                        @item.Tipo
                                    </span>
                                </td>
                                <td class="fw-semibold">R$ @item.Valor.ToString("N2")</td>
                                <td class="text-end">
                                    <a asp-controller="Movimentacoes"
                                       asp-action="Excluir"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-outline-danger"
                                       title="Excluir movimentação">
                                        <i class="bi bi-trash"></i> Excluir
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Nenhuma movimentação registrada.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>