<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SistemaGastosWeb</title>
    
    <!-- Bootstrap, Ícones e Chart.js -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <style>
        body {
            background-color: #0f172a; /* Fundo escuro base */
            font-family: system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
        }

        /* Estrutura Principal Flexbox */
        .app-container {
            display: flex;
            min-height: 100vh;
        }

        /* 1. Sidebar Escura Lateral */
        .sidebar {
            width: 260px;
            background-color: #0f172a; /* Azul escuro do menu */
            color: #94a3b8;
            display: flex;
            flex-direction: column;
            padding: 24px 16px;
            flex-shrink: 0;
        }

        .sidebar-brand {
            color: #ffffff;
            font-size: 1.4rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            margin-bottom: 32px;
            padding-left: 12px;
            text-decoration: none;
        }

        .sidebar-brand i {
            color: #10b981; /* Ícone Verde */
            font-size: 1.6rem;
        }

        .sidebar-menu {
            list-style: none;
            padding: 0;
            margin: 0;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        /* Item Normal (Cinza) */
        .sidebar-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 12px 16px;
            color: #94a3b8;
            text-decoration: none;
            font-weight: 500;
            border-radius: 10px;
            transition: all 0.2s ease;
        }

            /* Quando passa o mouse por cima (Verde suave) */
            .sidebar-link:hover {
                color: #ffffff;
                background-color: #10b981; /* Verde LuckFin */
            }

            /* Quando a página está selecionada/ativa */
            .sidebar-link.active {
                background-color: #10b981; /* Verde LuckFin */
                color: #ffffff;
                font-weight: 600;
            }

        /* 2. Área de Conteúdo Clara */
        .main-wrapper {
            flex-grow: 1;
            background-color: #f8fafc; /* Fundo claro interno */
            border-top-left-radius: 24px;
            border-bottom-left-radius: 24px;
            padding: 32px 40px;
            min-height: 100vh;
            box-sizing: border-box;
        }
    </style>
</head>
<body>

    <div class="app-container">
        <!-- Sidebar Esquerda Escura -->
        <aside class="sidebar">
            <a asp-controller="Home" asp-action="Index" class="sidebar-brand">
                <i class="bi bi-clover"></i>
                <span>LuckFin</span>
            </a>

            @{
                var controllerAtual = ViewContext.RouteData.Values["Controller"]?.ToString();
            }

            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Home" asp-action="Index"
                       class="sidebar-link @(controllerAtual == "Home" ? "active" : "")">
                        <i class="bi bi-house-door"></i>
                        <span>Visão Geral</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Movimentacoes" asp-action="Index"
                       class="sidebar-link @(controllerAtual == "Movimentacoes" ? "active" : "")">
                        <i class="bi bi-arrow-down-up"></i>
                        <span>Movimentações</span>
                    </a>
                </li>
            </ul>
        </aside>

        <!-- Área Central de Conteúdo (Clara) -->
        <main class="main-wrapper">
            @RenderBody()
        </main>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>